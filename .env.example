# Sao chép thành .env.local và điền giá trị. KHÔNG commit file .env.local.
# Biến có tiền tố NEXT_PUBLIC_ sẽ lộ ra trình duyệt — chỉ dùng cho giá trị công khai.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở server và script seed. Tuyệt đối không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Chuỗi kết nối Postgres cho Supabase CLI (npm run db:push)
# Supabase → Connect → Session pooler → URI (thay [YOUR-PASSWORD] bằng mật khẩu DB)
SUPABASE_DB_URL=

# Gemini — chỉ dùng ở server (các bước sau).
GEMINI_API_KEY=
